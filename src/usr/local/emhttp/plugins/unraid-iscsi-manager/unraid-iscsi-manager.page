<?php

define('IZM_SCRIPT', '/usr/local/emhttp/plugins/unraid-iscsi-manager/scripts/zvol-manager.sh');

function izm_h($value) {
    return htmlspecialchars((string)$value, ENT_QUOTES | ENT_SUBSTITUTE, 'UTF-8');
}

function izm_run(array $args) {
    $cmd = 'bash ' . escapeshellarg(IZM_SCRIPT);
    foreach ($args as $arg) {
        $cmd .= ' ' . escapeshellarg((string)$arg);
    }
    $cmd .= ' 2>&1';
    $out = [];
    $ret = 0;
    exec($cmd, $out, $ret);
    return [$ret, trim(implode("\n", $out))];
}

function izm_rows(array $args, $columns) {
    [$ret, $output] = izm_run($args);
    if ($ret !== 0 || $output === '') return [];
    $rows = [];
    foreach (preg_split('/\R/', $output) as $line) {
        if ($line === '') continue;
        $parts = explode("\t", $line);
        $parts = array_pad($parts, $columns, '');
        $rows[] = array_slice($parts, 0, $columns);
    }
    return $rows;
}

function izm_bytes($value) {
    if (!is_numeric($value)) return (string)$value;
    $n = (float)$value;
    $units = ['B', 'KiB', 'MiB', 'GiB', 'TiB', 'PiB'];
    $i = 0;
    while ($n >= 1024 && $i < count($units) - 1) {
        $n /= 1024;
        $i++;
    }
    if ($i === 0) return number_format($n, 0) . ' ' . $units[$i];
    $digits = $n >= 100 ? 0 : ($n >= 10 ? 1 : 2);
    return number_format($n, $digits) . ' ' . $units[$i];
}

function izm_block($value) {
    if (!is_numeric($value)) return (string)$value;
    $n = (int)$value;
    if ($n >= 1024 && $n % 1024 === 0) return ($n / 1024) . 'K';
    return (string)$n;
}

function izm_creation($value) {
    if (ctype_digit((string)$value)) return date('Y-m-d H:i:s', (int)$value);
    return (string)$value;
}

function izm_load_pools() {
    $rows = izm_rows(['pools'], 5);
    $out = [];
    foreach ($rows as $row) {
        [$name, $size, $alloc, $free, $health] = $row;
        $out[] = compact('name', 'size', 'alloc', 'free', 'health');
    }
    return $out;
}

function izm_load_volumes() {
    $rows = izm_rows(['volumes'], 8);
    $out = [];
    foreach ($rows as $row) {
        [$name, $volsize, $used, $refer, $compression, $volblocksize, $refreservation, $origin] = $row;
        $pool = explode('/', $name, 2)[0];
        $provision = ($origin !== '' && $origin !== '-') ? 'Clone' : ((is_numeric($refreservation) && (int)$refreservation > 0) ? 'Thick' : 'Thin');
        $out[] = compact('name', 'pool', 'volsize', 'used', 'refer', 'compression', 'volblocksize', 'refreservation', 'origin', 'provision');
    }
    return $out;
}

function izm_load_snapshots($volume) {
    if ($volume === '') return [];
    $rows = izm_rows(['snapshots', $volume], 4);
    $out = [];
    foreach ($rows as $row) {
        [$name, $creation, $used, $refer] = $row;
        $out[] = compact('name', 'creation', 'used', 'refer');
    }
    return $out;
}

$message = '';
$error = '';

[$zfsCheck, $zfsCheckOutput] = izm_run(['pools']);
$zfsAvailable = ($zfsCheck === 0);

$pools = $zfsAvailable ? izm_load_pools() : [];
$volumes = $zfsAvailable ? izm_load_volumes() : [];

$requestedVolume = trim($_GET['zvol'] ?? $_POST['selected_zvol'] ?? '');
$volumeNames = array_column($volumes, 'name');
if ($requestedVolume === '' || !in_array($requestedVolume, $volumeNames, true)) {
    $requestedVolume = $volumeNames[0] ?? '';
}

if ($_SERVER['REQUEST_METHOD'] === 'POST' && $zfsAvailable) {
    $action = $_POST['action'] ?? '';
    $args = [];

    if ($action === 'create_volume') {
        $args = [
            'create-volume',
            trim($_POST['pool'] ?? ''),
            trim($_POST['name'] ?? ''),
            strtoupper(trim($_POST['size'] ?? '')),
            $_POST['provisioning'] ?? 'thin',
            isset($_POST['compression']) ? 'on' : 'off',
            $_POST['block'] ?? '16K',
        ];
    } elseif ($action === 'create_snapshot') {
        $args = [
            'create-snapshot',
            trim($_POST['selected_zvol'] ?? ''),
            trim($_POST['snapshot_name'] ?? ''),
        ];
    } elseif ($action === 'delete_snapshot') {
        $args = ['delete-snapshot', trim($_POST['snapshot'] ?? '')];
    } elseif ($action === 'clone_snapshot') {
        $args = [
            'clone-snapshot',
            trim($_POST['snapshot'] ?? ''),
            trim($_POST['clone_name'] ?? ''),
        ];
    } elseif ($action === 'refresh') {
        $source = trim($_POST['source'] ?? '');
        $targets = $_POST['targets'] ?? [];
        if (!is_array($targets)) $targets = [];
        $targets = array_values(array_filter(array_map('trim', $targets), fn($v) => $v !== ''));
        if (!isset($_POST['offline_confirm'])) {
            $error = 'Confirm that the source and target LUNs are disconnected before refresh.';
        } else {
            $args = array_merge(['refresh', $source], $targets);
        }
    }

    if ($error === '' && !empty($args)) {
        [$ret, $output] = izm_run($args);
        if ($ret === 0) {
            $message = $output !== '' ? $output : 'Operation completed.';
        } else {
            $error = preg_replace('/^ERROR:\s*/m', '', $output ?: 'Operation failed.');
        }

        $pools = izm_load_pools();
        $volumes = izm_load_volumes();
        $volumeNames = array_column($volumes, 'name');
        $requestedVolume = trim($_POST['selected_zvol'] ?? $_POST['source'] ?? $requestedVolume);
        if (!in_array($requestedVolume, $volumeNames, true)) {
            $requestedVolume = $volumeNames[0] ?? '';
        }
    }
}

$snapshots = $zfsAvailable ? izm_load_snapshots($requestedVolume) : [];
$csrf = izm_h($var['csrf_token'] ?? '');
?>

