<script>
function izmUpdateTargets() {
  const source = document.getElementById('refreshSource');
  if (!source) return;
  const selected = source.options[source.selectedIndex];
  const sourceName = selected.value;
  const sourcePool = selected.dataset.pool;
  document.querySelectorAll('.izm-target').forEach(function(label) {
    const checkbox = label.querySelector('input[type=checkbox]');
    const allowed = label.dataset.pool === sourcePool && label.dataset.volume !== sourceName;
    checkbox.disabled = !allowed;
    if (!allowed) checkbox.checked = false;
    label.classList.toggle('disabled', !allowed);
  });
}
document.addEventListener('DOMContentLoaded', izmUpdateTargets);
</script>
