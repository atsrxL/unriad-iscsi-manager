<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name       "unraid-iscsi-manager">
<!ENTITY author     "atsrxL">
<!ENTITY version    "@VERSION@">
<!ENTITY launch     "Settings/unraid-iscsi-manager">
<!ENTITY repo       "atsrxL/unriad-iscsi-manager">
<!ENTITY releaseURL "https://github.com/&repo;/releases/download/&version;">
<!ENTITY pluginURL  "https://github.com/&repo;/releases/latest/download/&name;.plg">
<!ENTITY plugin     "/boot/config/plugins/&name;">
<!ENTITY emhttp     "/usr/local/emhttp/plugins/&name;">
<!ENTITY pkgMD5     "@PACKAGE_MD5@">
]>

<PLUGIN
  name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  min="6.12.0"
  support="https://github.com/&repo;/issues"
  icon="database"
>

<CHANGES>
### @VERSION@
- Fix the blank/white plugin page by using the native Unraid xmenu tab container format.
- Add live iSCSI session discovery from targetcli: initiator IQN, initiator IP, SID, session state, connection state, mapped LUN, and mode.
- Distinguish configured/offline LUN mappings from actively connected initiators in Z Status.
- Show LIO SCSI UNMAP advertisement and ZVOL block-device discard capability.
- Add ZPOOL manual TRIM start/resume, suspend, cancel, and autotrim on/off controls.
- Add safe reclaim guidance: guest filesystem discard/UNMAP for ZVOLs, snapshot deletion for snapshot-pinned blocks, and pool TRIM for underlying SSD free extents.
- Add PHP/page and shell syntax linting to the release workflow.
</CHANGES>

<FILE Run="/bin/bash">
  <INLINE>
    if ! command -v zfs >/dev/null 2&gt;&amp;1 || ! command -v zpool >/dev/null 2&gt;&amp;1; then
      echo "ZFS tools were not found. This plugin requires an Unraid system with ZFS support."
      exit 1
    fi
    mkdir -p &plugin;/packages
    rm -f &plugin;/packages/&name;-*.txz 2>/dev/null || true
  </INLINE>
</FILE>

<FILE Name="&plugin;/packages/&name;-&version;.txz">
  <URL>&releaseURL;/&name;-&version;.txz</URL>
  <MD5>&pkgMD5;</MD5>
</FILE>

<FILE Run="/bin/bash">
  <INLINE>
    rm -rf &emhttp;
    /sbin/installpkg &plugin;/packages/&name;-&version;.txz
    chmod +x &emhttp;/scripts/*.sh 2>/dev/null || true
    echo ""
    echo "iSCSI ZVOL Manager &version; installed."
    echo "Open Settings -> iSCSI ZVOL Manager."
  </INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
  <INLINE>
    rm -rf &emhttp;
    rm -rf &plugin;
    echo "iSCSI ZVOL Manager removed. ZVOLs and snapshots were not modified."
  </INLINE>
</FILE>

</PLUGIN>
