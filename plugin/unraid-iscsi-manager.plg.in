<?xml version="1.0" standalone="yes"?>
<!DOCTYPE PLUGIN [
<!ENTITY name       "unraid-iscsi-manager">
<!ENTITY author     "atsrxL">
<!ENTITY version    "@VERSION@">
<!ENTITY launch     "Settings/unraid-iscsi-manager">
<!ENTITY repo       "atsrxL/unriad-iscsi-manager">
<!ENTITY releaseURL "https://github.com/&repo;/releases/download/&version;">
<!ENTITY pluginURL  "https://github.com/&repo;/releases/latest/download/&name;.plg">
<!ENTITY plugin     "/boot/config/plugins/&name;">
<!ENTITY emhttp     "/usr/local/emhttp/plugins/&name;">
<!ENTITY pkgMD5     "@PACKAGE_MD5@">
]>

<PLUGIN
  name="&name;"
  author="&author;"
  version="&version;"
  launch="&launch;"
  pluginURL="&pluginURL;"
  min="6.12.0"
  support="https://github.com/&repo;/issues"
  icon="database"
>

<CHANGES>
### @VERSION@
- Move all Pool Automatic/Manual TRIM controls out of Z Status and into Misc.
- Improve LIO backstore-to-ZVOL resolution using configfs device paths, targetcli info/ls output, real-device matching, and pool:zvol backstore-name inference.
- Show unresolved IQN/LUN mappings as diagnostics instead of silently presenting the affected ZVOLs as unmapped.
- Add compact action buttons directly to ZVOL, Snapshot, and Clone nodes in the resource tree.
- Add guided two-step dialogs for Create Snapshot and Create Clone so name fields no longer clutter the tree.
- Add safe inline Delete Snapshot and Delete Clone actions with dependency, iSCSI, and child-snapshot protection preserved.
- Keep the standalone AJAX status renderer and Markdown=false packaging safeguards introduced in 2026.08.19c.
</CHANGES>

<FILE Run="/bin/bash">
  <INLINE>
    if ! command -v zfs >/dev/null 2&gt;&amp;1 || ! command -v zpool >/dev/null 2&gt;&amp;1; then
      echo "ZFS tools were not found. This plugin requires an Unraid system with ZFS support."
      exit 1
    fi
    mkdir -p &plugin;/packages
    rm -f &plugin;/packages/&name;-*.txz 2>/dev/null || true
  </INLINE>
</FILE>

<FILE Name="&plugin;/packages/&name;-&version;.txz">
  <URL>&releaseURL;/&name;-&version;.txz</URL>
  <MD5>&pkgMD5;</MD5>
</FILE>

<FILE Run="/bin/bash">
  <INLINE>
    rm -rf &emhttp;
    /sbin/installpkg &plugin;/packages/&name;-&version;.txz
    chmod +x &emhttp;/scripts/*.sh 2>/dev/null || true

    # Force Unraid to rebuild the plugin-specific translation cache after an upgrade.
    rm -f /usr/local/emhttp/languages/zh_CN/&name;.dot 2>/dev/null || true

    mkdir -p &plugin;
    if [[ ! -f &plugin;/settings.cfg ]]; then
      echo 'AUTO_UNMAP=0' &gt; &plugin;/settings.cfg
    fi

    cat &gt; &plugin;/&name;.cron &lt;&lt;'CRON'
* * * * * /bin/bash &emhttp;/scripts/iscsi-unmap-policy.sh &gt;/dev/null 2&gt;&amp;1
CRON
    chmod 0644 &plugin;/&name;.cron
    /usr/local/sbin/update_cron 2>/dev/null || true

    /bin/bash &emhttp;/scripts/iscsi-unmap-policy.sh &gt;/dev/null 2&gt;&amp;1 || true

    echo ""
    echo "iSCSI ZVOL Manager &version; installed."
    echo "Open Settings -> iSCSI ZVOL Manager."
  </INLINE>
</FILE>

<FILE Run="/bin/bash" Method="remove">
  <INLINE>
    rm -rf &emhttp;
    rm -f /usr/local/emhttp/languages/zh_CN/&name;.txt /usr/local/emhttp/languages/zh_CN/&name;.dot 2>/dev/null || true
    rm -rf &plugin;
    /usr/local/sbin/update_cron 2>/dev/null || true
    echo "iSCSI ZVOL Manager removed. ZVOLs and snapshots were not modified."
  </INLINE>
</FILE>

</PLUGIN>
